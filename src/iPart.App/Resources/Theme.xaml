<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!--
        Motyw iPart (ADR-0014): Material Design in XAML, style MaterialDesign3.Defaults.
        Kolory tylko z jednego słownika, nazwane według roli, używane przez DynamicResource — nigdy wpisane w widoku.
        Kolory danych (linie BOM, statusy MPN, kompletacja): DataColors.xaml.
    -->
    <ResourceDictionary.MergedDictionaries>
        <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Blue" SecondaryColor="Orange" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
        <ResourceDictionary Source="DataColors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Kolory interfejsu według roli -->
    <SolidColorBrush x:Key="Ui.Background" Color="#F3F5F8" />
    <SolidColorBrush x:Key="Ui.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Ui.Border" Color="#D9DDE3" />
    <SolidColorBrush x:Key="Ui.Text" Color="#1B1B1B" />
    <SolidColorBrush x:Key="Ui.TextSecondary" Color="#5A6270" />
    <SolidColorBrush x:Key="Ui.Selected" Color="#E3ECFB" />
    <SolidColorBrush x:Key="Ui.Success.Background" Color="#DDF0D5" />
    <SolidColorBrush x:Key="Ui.Success.Text" Color="#22561A" />
    <SolidColorBrush x:Key="Ui.Warning.Background" Color="#FDE6D3" />
    <SolidColorBrush x:Key="Ui.Warning.Text" Color="#7A3A00" />
    <SolidColorBrush x:Key="Ui.Info.Background" Color="#E3ECFB" />
    <SolidColorBrush x:Key="Ui.Info.Text" Color="#163A8A" />

    <!-- Tabele: tylko do odczytu i wirtualizacja (duże BOM-y i listy komponentów) -->
    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="materialDesign:DataGridAssist.CellPadding" Value="8,4" />
        <Setter Property="materialDesign:DataGridAssist.ColumnHeaderPadding" Value="8,6" />
    </Style>

    <!-- 8.1 Linie BOM: niepotwierdzona linia; pełna informacja w podpowiedzi (8.4) -->
    <Style x:Key="BomLineRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="ToolTip" Value="{Binding Tooltip}" />
        <Style.Triggers>
            <!-- Kolejność przy kilku znaczeniach (8.4): DNP → niepotwierdzona → montaż inny niż SMT; liczy ją BomLineItem.ColorKey. -->
            <DataTrigger Binding="{Binding ColorKey}" Value="Dnp">
                <Setter Property="Background" Value="{DynamicResource Data.Line.Dnp}" />
                <Setter Property="Foreground" Value="{DynamicResource Data.Text}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ColorKey}" Value="Unconfirmed">
                <Setter Property="Background" Value="{DynamicResource Data.Line.Unconfirmed}" />
                <Setter Property="Foreground" Value="{DynamicResource Data.Text}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ColorKey}" Value="NonSmt">
                <Setter Property="Background" Value="{DynamicResource Data.Line.NonSmtMounting}" />
                <Setter Property="Foreground" Value="{DynamicResource Data.Text}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 8.1 Komponenty: montaż THT, Press-Fit, MECH albo Plugs -->
    <Style x:Key="ComponentRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsNonSmtMounting}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Data.Line.NonSmtMounting}" />
                <Setter Property="Foreground" Value="{DynamicResource Data.Text}" />
                <Setter Property="ToolTip" Value="{Binding Mounting}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Odstęp między sąsiednimi przyciskami w starszych widokach -->
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- Karta: biała powierzchnia z obramowaniem -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ui.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ui.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Ui.Text}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Ui.Text}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Ui.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
