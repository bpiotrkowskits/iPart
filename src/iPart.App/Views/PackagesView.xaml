<UserControl x:Class="iPart.App.Views.PackagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>

        <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Otwórz pakiet" Command="{Binding OpenCommand}" />
            <TextBlock Text="Pakiet Elektroniczny" Style="{DynamicResource PageTitle}" VerticalAlignment="Center" />
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Odśwież" Command="{Binding RefreshCommand}" Margin="8,0,0,0" Style="{DynamicResource MaterialDesignOutlinedButton}" />
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Szukaj pakietu albo Klienta (Enter = odśwież)"
                     Style="{DynamicResource MaterialDesignOutlinedTextBox}">
                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding RefreshCommand}" /></TextBox.InputBindings>
            </TextBox>
        </DockPanel>

        <Border Grid.Row="2" Style="{DynamicResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}" AutomationProperties.Name="Lista pakietów">
                <DataGrid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenCommand}" />
                    <KeyBinding Key="Enter" Command="{Binding OpenCommand}" />
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Pakiet" Binding="{Binding Code}" Width="200" />
                    <DataGridTextColumn Header="Rewizja Klienta" Binding="{Binding CustomerRevision}" Width="120" />
                    <DataGridTextColumn Header="Klient" Binding="{Binding CustomerName}" Width="180" />
                    <DataGridTextColumn Header="Wczytane BOM" Binding="{Binding RevisionCount}" Width="120" />
                    <DataGridTextColumn Header="Utworzył" Binding="{Binding CreatedBy}" Width="180" />
                    <DataGridTextColumn Header="Opis" Binding="{Binding Description}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Grid.Column="2" Style="{DynamicResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Nowy pakiet" Style="{DynamicResource SectionTitle}" />
                <TextBox Text="{Binding NewCode, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Kod pakietu (np. PCBA1)" Margin="0,0,0,8" />
                <TextBox Text="{Binding NewRevision, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Rewizja Klienta (opcjonalnie)" Margin="0,0,0,8" />
                <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" materialDesign:HintAssist.Hint="Klient" Margin="0,0,0,8" />
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Dodaj Klienta" Command="{Binding AddCustomerCommand}" Margin="8,0,0,0" Style="{DynamicResource MaterialDesignOutlinedButton}" />
                    <TextBox Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Nowy Klient" />
                </DockPanel>
                <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Opis (opcjonalnie)" Margin="0,0,0,12" />
                <Button Content="Utwórz pakiet" Command="{Binding CreatePackageCommand}" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding Status}" Style="{DynamicResource Hint}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</UserControl>
