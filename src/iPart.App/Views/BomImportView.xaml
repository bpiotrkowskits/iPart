<UserControl x:Class="iPart.App.Views.BomImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:iPart.App.Controls">
    <Grid Margin="24,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <controls:ProcessStepper Current="1" Margin="0,0,0,8" />
        <TextBlock Grid.Row="1" Text="Import BOM" Style="{DynamicResource PageTitle}" Margin="0,0,0,12" />

        <!-- Klient i pakiet: dwie osobne sekcje wyboru -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
            <Border Style="{DynamicResource Card}">
                <StackPanel>
                    <TextBlock Text="1. Klient" Style="{DynamicResource SectionTitle}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Odśwież" Command="{Binding RefreshCommand}" Style="{DynamicResource MaterialDesignOutlinedButton}" Margin="8,0,0,0" />
                        <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" materialDesign:HintAssist.Hint="Wybierz Klienta"
                                  Style="{DynamicResource MaterialDesignOutlinedComboBox}" AutomationProperties.Name="Klient" />
                    </DockPanel>
                    <TextBlock Text="Nowego Klienta dodasz na stronie „Pakiet Elektroniczny”." Style="{DynamicResource Hint}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{DynamicResource Card}">
                <StackPanel>
                    <TextBlock Text="2. Pakiet Elektroniczny" Style="{DynamicResource SectionTitle}" />
                    <ComboBox ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}" DisplayMemberPath="DisplayName"
                              materialDesign:HintAssist.Hint="Wybierz pakiet tego Klienta" Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                              AutomationProperties.Name="Pakiet" Margin="0,0,0,8" />
                    <TextBlock Text="Nowy pakiet utworzysz na stronie „Pakiet Elektroniczny”." Style="{DynamicResource Hint}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- BOM Klienta -->
        <DockPanel Grid.Row="3" Margin="0,0,0,8">
            <Button Content="3. Wybierz plik BOM (.xlsx)" Command="{Binding ChooseFileCommand}" DockPanel.Dock="Left" Margin="0,0,12,0" />
            <TextBox Text="{Binding FilePath, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" />
        </DockPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Arkusz: " VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Sheets}" SelectedItem="{Binding SelectedSheet}" MinWidth="160" Margin="0,0,16,0" />
            <TextBlock Text="Wiersz nagłówków: " VerticalAlignment="Center" />
            <TextBox Text="{Binding HeaderRow, UpdateSourceTrigger=LostFocus}" Width="50" VerticalContentAlignment="Center" Margin="0,0,16,0" />
            <Button Content="Podpowiedz po nazwach nagłówków" Command="{Binding SuggestCommand}" Style="{DynamicResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
            <Button Content="Podgląd" Command="{Binding PreviewCommand}" />
        </StackPanel>
        <DataGrid Grid.Row="5" ItemsSource="{Binding Columns}" IsReadOnly="False" SelectionUnit="Cell" AutomationProperties.Name="Przypisanie kolumn">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Comparator" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Compare, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanCompare}" HorizontalAlignment="Center"
                                      ToolTip="Porównaj tę kolumnę z P&amp;P (Value, Footprint, Description, PartNumber)" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Kol." Binding="{Binding Letter}" IsReadOnly="True" Width="45" />
                <DataGridTextColumn Header="Nagłówek Klienta" Binding="{Binding Header}" IsReadOnly="True" Width="200" />
                <DataGridTemplateColumn Header="Pole" Width="280">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.FieldOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      SelectedValuePath="Field" DisplayMemberPath="Label"
                                      SelectedValue="{Binding Field, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Priorytet (1 = nadrzędna)" Binding="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                <DataGridTextColumn Header="Przykładowe wartości" Binding="{Binding Sample}" IsReadOnly="True" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="6" Text="{Binding Summary}" Margin="0,8" FontWeight="SemiBold" />
        <TabControl Grid.Row="7">
            <TabItem Header="Problemy">
                <DataGrid ItemsSource="{Binding Issues}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ważność" Binding="{Binding SeverityLabel}" Width="100" />
                        <DataGridTextColumn Header="Linia" Binding="{Binding LineNumber}" Width="55" />
                        <DataGridTextColumn Header="Wiersz Excela" Binding="{Binding SourceRow}" Width="95" />
                        <DataGridTextColumn Header="Opis" Binding="{Binding Message}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Podgląd linii">
                <DataGrid ItemsSource="{Binding PreviewLines}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Linia" Binding="{Binding LineNumber}" Width="50" />
                        <DataGridTextColumn Header="Designator" Binding="{Binding Designators}" Width="200" />
                        <DataGridTextColumn Header="Szt. desyg." Binding="{Binding DesignatorCount}" Width="70" />
                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="65" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="140" />
                        <DataGridTextColumn Header="Footprint" Binding="{Binding Footprint}" Width="120" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="160" />
                        <DataGridTextColumn Header="PartNumber" Binding="{Binding PartNumber}" Width="160" />
                        <DataGridTextColumn Header="Kolumny dodatkowe" Binding="{Binding Extras}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="8" Margin="0,8,0,0">
            <Button Content="Dalej: Import P&amp;P  →" Command="{Binding SaveCommand}" DockPanel.Dock="Right" Margin="12,0,0,0" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
    </Grid>
</UserControl>
