<UserControl x:Class="iPart.App.Views.PnpImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Left" Command="{Binding BackCommand}" Style="{DynamicResource MaterialDesignIconButton}" ToolTip="Wróć do BOM pakietu"
                    AutomationProperties.Name="Wróć do BOM pakietu" Margin="0,0,8,0">
                <materialDesign:PackIcon Kind="ArrowLeft" />
            </Button>
            <TextBlock Text="{Binding Title}" Style="{DynamicResource PageTitle}" FontSize="20" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <Button DockPanel.Dock="Left" Content="Wybierz plik P&amp;P…" Command="{Binding ChooseFileCommand}" />
            <TextBox DockPanel.Dock="Right" Text="{Binding HeaderRow, UpdateSourceTrigger=LostFocus}" Width="150" materialDesign:HintAssist.Hint="Wiersz nagłówków"
                     Style="{DynamicResource MaterialDesignOutlinedTextBox}" Margin="12,0,0,0" />
            <TextBox Text="{Binding FilePath, Mode=OneWay}" IsReadOnly="True" materialDesign:HintAssist.Hint="Plik" Style="{DynamicResource MaterialDesignOutlinedTextBox}" />
        </DockPanel>
        <Border Grid.Row="2" Style="{DynamicResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Columns}" IsReadOnly="False" SelectionUnit="Cell" AutomationProperties.Name="Mapowanie kolumn P&amp;P">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nagłówek Klienta" Binding="{Binding Header}" IsReadOnly="True" Width="220" />
                    <DataGridTemplateColumn Header="Pole w iPart" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.FieldOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          SelectedValuePath="Field" DisplayMemberPath="Label" SelectedValue="{Binding Field, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Przykładowe wartości" Binding="{Binding Sample}" IsReadOnly="True" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12">
            <Button Content="Podgląd" Command="{Binding ShowPreviewCommand}" Style="{DynamicResource MaterialDesignOutlinedButton}" />
            <Button Content="Zapisz P&amp;P" Command="{Binding SaveCommand}" />
        </StackPanel>
        <Border Grid.Row="4" Style="{DynamicResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Preview}" AutomationProperties.Name="Podgląd P&amp;P">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Wiersz" Binding="{Binding SourceRow}" Width="70" />
                    <DataGridTextColumn Header="Designator" Binding="{Binding Designator}" Width="120" />
                    <DataGridTextColumn Header="X" Binding="{Binding X}" Width="90" />
                    <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="90" />
                    <DataGridTextColumn Header="Obrót" Binding="{Binding Rotation}" Width="80" />
                    <DataGridTextColumn Header="Strona" Binding="{Binding Side}" Width="80" />
                    <DataGridTextColumn Header="Footprint" Binding="{Binding Footprint}" Width="180" />
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <TextBlock Grid.Row="5" Text="{Binding Status}" Style="{DynamicResource Hint}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</UserControl>
