<UserControl x:Class="iPart.App.Views.AccountSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Background="{DynamicResource Ui.Background}">
        <Border Style="{DynamicResource Card}" Width="560" MaxHeight="640" Margin="24" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Wybierz konto" Style="{DynamicResource PageTitle}" />
                    <TextBlock Text="{Binding Status}" Style="{DynamicResource Hint}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <TextBox DockPanel.Dock="Top" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                         materialDesign:HintAssist.Hint="Szukaj po nazwie albo loginie" Style="{DynamicResource MaterialDesignOutlinedTextBox}" />
                <Button DockPanel.Dock="Bottom" Content="Dalej" Command="{Binding ContinueCommand}" IsDefault="True" HorizontalAlignment="Right" Margin="0,12,0,0" />
                <ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding Selected}" MinHeight="200"
                         AutomationProperties.Name="Konta">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Style="{DynamicResource Hint}">
                                    <Run Text="{Binding Login, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DepartmentText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
