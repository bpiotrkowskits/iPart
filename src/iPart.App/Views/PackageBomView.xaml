<UserControl x:Class="iPart.App.Views.PackageBomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:iPart.App.Controls">
    <UserControl.Resources>
        <!-- Własna kopia konwertera: zasoby okna nie są widoczne z szablonów zakładek wczytywanych później. -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- Komórki tabel w jednej linii; pełna treść w chmurce wiersza. -->
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>
        <!-- Wybór wartości pola: BOM / P&P (/ własna) -->
        <DataTemplate x:Key="FieldChoiceBomPnp">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <RadioButton IsChecked="{Binding IsBom}" Content="{Binding BomText}" Margin="0,2,0,0" />
                <RadioButton IsChecked="{Binding IsPnp}" Content="{Binding PnpText}" IsEnabled="{Binding PnpAvailable}" Margin="0,2,0,0" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="FieldChoiceWithOwn">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <RadioButton IsChecked="{Binding IsBom}" Content="{Binding BomText}" Margin="0,2,0,0" />
                <RadioButton IsChecked="{Binding IsPnp}" Content="{Binding PnpText}" IsEnabled="{Binding PnpAvailable}" Margin="0,2,0,0" />
                <DockPanel Margin="0,2,0,0">
                    <RadioButton DockPanel.Dock="Left" IsChecked="{Binding IsOwn}" Content="Własna:" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Own, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" IsEnabled="{Binding IsOwn}" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <!-- Postęp procesu -->
        <Border Background="{DynamicResource Ui.Surface}" Padding="24,10,24,2">
            <controls:ProcessStepper Current="{Binding Stage}" />
        </Border>

        <!-- Nagłówek pakietu -->
        <Border Grid.Row="1" Background="{DynamicResource Ui.Surface}" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,0,1" Padding="24,8,24,12">
            <DockPanel>
                <Button DockPanel.Dock="Left" Command="{Binding BackCommand}" Style="{DynamicResource MaterialDesignIconButton}" ToolTip="Wróć do listy pakietów"
                        AutomationProperties.Name="Wróć do listy pakietów" Margin="0,0,8,0">
                    <materialDesign:PackIcon Kind="ArrowLeft" />
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Revisions}" SelectedItem="{Binding SelectedRevision}" DisplayMemberPath="DisplayName"
                              MinWidth="260" materialDesign:HintAssist.Hint="Wczytany BOM" Style="{DynamicResource MaterialDesignOutlinedComboBox}" Margin="0,0,12,0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Package.DisplayName}" Style="{DynamicResource PageTitle}" FontSize="20" />
                    <TextBlock Text="{Binding Summary}" Style="{DynamicResource Hint}" />
                    <TextBlock Text="{Binding PnpState}" Style="{DynamicResource Hint}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Krok 3: Comparator, Wykaz Różnic, Tylko w P&P ═══ -->
        <TabControl Grid.Row="2" Margin="24,12,0,0" SelectedIndex="{Binding ComparatorTab}" Style="{DynamicResource MaterialDesignFilledTabControl}"
                    Visibility="{Binding IsComparatorStage, Converter={StaticResource BoolToVisibility}}">

            <!-- ═══ Comparator: BOM i P&P obok siebie + panel linii ═══ -->
            <TabItem Header="Comparator">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="420" /></Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,12,0">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" VerticalAlignment="Center">
                            <TextBlock Text="Porównywane:" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <CheckBox Content="Value" IsChecked="{Binding CompareValue}" Margin="0,0,16,0" />
                            <CheckBox Content="Footprint" IsChecked="{Binding CompareFootprint}" Margin="0,0,16,0" />
                            <CheckBox Content="Description" IsChecked="{Binding CompareDescription}" Margin="0,0,16,0" />
                            <CheckBox Content="PartNumber" IsChecked="{Binding ComparePartNumber}" Margin="0,0,40,0" />
                            <TextBlock Text="Filtrowanie:" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <CheckBox Content="Pokaż tylko niezgodności" IsChecked="{Binding OnlyDifferences}" Margin="0,0,16,0" />
                            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="260" materialDesign:HintAssist.Hint="Szukaj: desygnator, wartość, Part Number" />
                        </WrapPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource Data.Line.Unconfirmed}" Margin="0,0,4,0" /><TextBlock Text="linia niezatwierdzona   " Style="{DynamicResource Hint}" />
                            <Border Background="{DynamicResource Data.Cell.Difference}" Padding="4,0" Margin="0,0,4,0"><TextBlock Text="Abc" FontWeight="Bold" /></Border><TextBlock Text="pole różni się od P&amp;P   · najedź na linię, żeby zobaczyć wszystko" Style="{DynamicResource Hint}" />
                        </WrapPanel>
                        <Border Style="{DynamicResource Card}" Padding="0">
                            <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" RowStyle="{DynamicResource BomLineRowStyle}" CellStyle="{DynamicResource ComparatorCellStyle}"
                                      HorizontalScrollBarVisibility="Visible" AutomationProperties.Name="Comparator">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Designators BOM" Binding="{Binding Designators}" Width="170" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Designators P&amp;P" Binding="{Binding DesignatorsPnpList}" Width="170" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Value BOM" Binding="{Binding ValueBom}" Width="150" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Value P&amp;P" Binding="{Binding ValuePnp}" Width="150" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Footprint BOM" Binding="{Binding FootprintBom}" Width="150" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Footprint P&amp;P" Binding="{Binding FootprintPnp}" Width="150" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Description BOM" Binding="{Binding DescriptionBom}" Width="260" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Description P&amp;P" Binding="{Binding DescriptionPnp}" Width="260" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="PartNumber BOM" Binding="{Binding PartNumberBom}" Width="180" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="PartNumber P&amp;P" Binding="{Binding PartNumberPnp}" Width="180" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Stan" Binding="{Binding State}" Width="110" ElementStyle="{StaticResource CellText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </DockPanel>

                    <Border Grid.Column="1" Background="{DynamicResource Ui.Surface}" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="1,0,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Margin="16,12,16,0" Style="{DynamicResource SectionTitle}"
                                       Text="{Binding SelectedLine.LineLabel, StringFormat=Linia {0}, TargetNullValue=Wybierz linię z tabeli}" />
                            <TabControl Style="{DynamicResource MaterialDesignFilledTabControl}">
                                <TabItem Header="Rozbieżność">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="16,8,16,16">
                                            <TextBlock Text="Wynik porównania z P&amp;P" Style="{StaticResource PanelTitle}" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding SelectedLine.Groups}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- Każda różnica: nazwa pola, BOM (cały tekst), P&P (cały tekst); na końcu desygnatory grupy. -->
                                                        <Border x:Name="box" Background="{DynamicResource Ui.Warning.Background}" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                                            <StackPanel TextElement.Foreground="{DynamicResource Ui.Warning.Text}" x:Name="content">
                                                                <ItemsControl ItemsSource="{Binding Details}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel Margin="0,0,0,6">
                                                                                <TextBlock Text="{Binding Label}" FontWeight="Bold" />
                                                                                <TextBlock Text="{Binding BomText}" TextWrapping="Wrap" />
                                                                                <TextBlock Text="{Binding PnpText}" TextWrapping="Wrap" />
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock Text="{Binding Note}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,2">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Designators}"><Run Text="{Binding Designators, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding Count, Mode=OneWay}" /><Run Text=" szt.)" /></TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Matches}" Value="True">
                                                                <Setter TargetName="box" Property="Background" Value="{DynamicResource Ui.Success.Background}" />
                                                                <Setter TargetName="content" Property="TextElement.Foreground" Value="{DynamicResource Ui.Success.Text}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding SelectedLine.QuantityWarning}" Foreground="{DynamicResource Ui.Warning.Text}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SelectedLine.ConfirmationText}" TextWrapping="Wrap" Margin="0,8,0,0" />

                                            <!-- Rozdzielenie linii według grup P&P -->
                                            <Border Background="{DynamicResource Ui.Warning.Background}" CornerRadius="6" Padding="10" Margin="0,10,0,0"
                                                    Visibility="{Binding SelectedLine.CanSplit, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                                <StackPanel>
                                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Ui.Warning.Text}"
                                                               Text="Desygnatory tej linii mają w P&amp;P różne dane (np. R1–R5 0402, R6–R10 0603). Rozdziel linię — każda grupa dostanie własną linię na końcu BOM." />
                                                    <Button Content="Rozdziel linię według P&amp;P" Command="{Binding SplitLineCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Linia w Wykazie Różnic: zatwierdzenie tylko w zakładce Wykaz Różnic. -->
                                            <Border Background="{DynamicResource Ui.Info.Background}" CornerRadius="6" Padding="10" Margin="0,10,0,0"
                                                    Visibility="{Binding SelectedLine.WaitsInDifferenceList, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Ui.Info.Text}"
                                                           Text="Linia jest w Wykazie Różnic — zatwierdzisz ją w zakładce „Wykaz Różnic” (na podstawie odpowiedzi Klienta albo wcześniejszej realizacji)." />
                                            </Border>
                                            <StackPanel Visibility="{Binding SelectedLine.CanDecideInComparator, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                            <TextBlock Text="Co robimy z linią?" Style="{StaticResource PanelTitle}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <RadioButton Content="Zatwierdź" IsChecked="{Binding IsApproveAction}" GroupName="lineAction" Margin="0,0,24,0" />
                                                <RadioButton Content="Do Wykazu Różnic" IsChecked="{Binding IsDifferenceListAction}" GroupName="lineAction" />
                                            </StackPanel>
                                            <!-- a) Zatwierdź: wartości z BOM albo z P&P -->
                                            <StackPanel Visibility="{Binding IsApproveAction, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Brak różnic w porównywanych polach — linia zostanie zatwierdzona z danymi z BOM." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers><DataTrigger Binding="{Binding LineChoices.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ItemsControl ItemsSource="{Binding LineChoices}" ItemTemplate="{StaticResource FieldChoiceBomPnp}" />
                                                <TextBox Text="{Binding LineComment, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Komentarz (opcjonalnie)"
                                                         Style="{DynamicResource MaterialDesignOutlinedTextBox}" Margin="0,4,0,8" />
                                                <Button Content="Zatwierdź linię" Command="{Binding ApproveLineCommand}" HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <!-- b) Do Wykazu Różnic: pytanie do Klienta -->
                                            <StackPanel Visibility="{Binding IsDifferenceListAction, Converter={StaticResource BoolToVisibility}}">
                                                <TextBox Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Pytanie do Klienta"
                                                         Style="{DynamicResource MaterialDesignOutlinedTextBox}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" Margin="0,0,0,8" />
                                                <Button Content="Dodaj do Wykazu Różnic" Command="{Binding AddToDifferenceListCommand}" HorizontalAlignment="Left" />
                                            </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Historia">
                                    <ListBox ItemsSource="{Binding History}" Margin="8" AutomationProperties.Name="Historia pakietu">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,4">
                                                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"><Run Text="{Binding OccurredAtUtc, Mode=OneWay, StringFormat=dd.MM.yyyy HH:mm}" /><Run Text=" · " /><Run Text="{Binding Author, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Operation, Mode=OneWay}" /></TextBlock>
                                                    <ItemsControl ItemsSource="{Binding Changes}">
                                                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Opacity="0.75" /></DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding Comment}" TextWrapping="Wrap" FontStyle="Italic" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </TabItem>
                            </TabControl>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══ Wykaz Różnic: tabela we wzorze firmowym + panel zatwierdzenia ═══ -->
            <TabItem Header="Wykaz Różnic">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="420" /></Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,12,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Eksportuj do Excela" Command="{Binding ExportDifferenceListCommand}" Margin="0,0,8,0" />
                            <Button Content="Wczytaj odpowiedzi z Excela…" Command="{Binding ImportAnswersCommand}" Style="{DynamicResource MaterialDesignOutlinedButton}" />
                        </StackPanel>
                        <Border Style="{DynamicResource Card}" Padding="0">
                            <DataGrid ItemsSource="{Binding DifferenceList}" SelectedItem="{Binding SelectedWrd}" RowStyle="{DynamicResource BomLineRowStyle}" AutomationProperties.Name="Wykaz Różnic">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Designator BOM" Binding="{Binding Wrd.DesignatorsBom}" Width="120" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Designator P&amp;P" Binding="{Binding Wrd.DesignatorsPnp}" Width="120" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Part TS BOM" Binding="{Binding Wrd.PartTsBom}" Width="100" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Part TS P&amp;P" Binding="{Binding Wrd.PartTsPnp}" Width="100" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Footprint BOM" Binding="{Binding Wrd.FootprintBom}" Width="100" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Footprint P&amp;P" Binding="{Binding Wrd.FootprintPnp}" Width="100" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Description BOM" Binding="{Binding Wrd.DescriptionBom}" Width="130" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Description P&amp;P" Binding="{Binding Wrd.DescriptionPnp}" Width="130" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="PYTANIE" Binding="{Binding Wrd.Question}" Width="*" MinWidth="160" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="ODPOWIEDŹ" Binding="{Binding Wrd.Answer}" Width="*" MinWidth="160" ElementStyle="{StaticResource CellText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </DockPanel>

                    <Border Grid.Column="1" Background="{DynamicResource Ui.Surface}" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="1,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16">
                                <TextBlock Style="{DynamicResource SectionTitle}" Text="{Binding SelectedWrd.LineLabel, StringFormat=Linia {0}, TargetNullValue=Wybierz pozycję z Wykazu}" />
                                <TextBlock Text="{Binding SelectedWrd.Question, StringFormat=Pytanie: {0}}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding SelectedWrd.ConfirmationText}" TextWrapping="Wrap" Style="{DynamicResource Hint}" />

                                <TextBlock Text="Zatwierdź na podstawie" Style="{StaticResource PanelTitle}" />
                                <RadioButton Content="Odpowiedzi Klienta" IsChecked="{Binding IsCustomerAnswer}" GroupName="wrdBasis" Margin="0,0,0,4" />
                                <RadioButton Content="Wcześniejszej realizacji" IsChecked="{Binding IsPreviousRealization}" GroupName="wrdBasis" Margin="0,0,0,8" />
                                <TextBox Text="{Binding WrdText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" Margin="0,0,0,8"
                                         Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Odpowiedź Klienta / komentarz (której realizacji dotyczy)" />

                                <TextBlock Text="Wartość do zapisania" Style="{StaticResource PanelTitle}" />
                                <ItemsControl ItemsSource="{Binding WrdChoices}" ItemTemplate="{StaticResource FieldChoiceWithOwn}" />
                                <Button Content="Zatwierdź pozycję" Command="{Binding ApproveWrdCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ═══ Tylko w P&P: wiersze P&P, których desygnatorów nie ma w BOM ═══ -->
            <TabItem Header="Tylko w P&amp;P">
                <DockPanel Margin="0,12,24,0">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding OnlyInPnpText}" TextWrapping="Wrap" Style="{DynamicResource Hint}" Margin="0,0,0,8" />
                    <Border Style="{DynamicResource Card}" Padding="0">
                        <DataGrid ItemsSource="{Binding OnlyInPnpRows}" AutomationProperties.Name="Tylko w P&amp;P">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Designator" Binding="{Binding Designator}" Width="120" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" MinWidth="120" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Footprint" Binding="{Binding Footprint}" Width="*" MinWidth="110" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" MinWidth="160" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="X mm" Binding="{Binding XMm}" Width="80" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Y mm" Binding="{Binding YMm}" Width="80" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Obrót" Binding="{Binding Rotation}" Width="70" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Strona" Binding="{Binding Side}" Width="70" ElementStyle="{StaticResource CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- ═══ Krok 4: Integracja Danych, Zatwierdzenie i wersje ═══ -->
        <TabControl Grid.Row="2" Margin="24,12,0,0" SelectedIndex="{Binding IntegrationTab}" Style="{DynamicResource MaterialDesignFilledTabControl}"
                    Visibility="{Binding IsIntegrationStage, Converter={StaticResource BoolToVisibility}}">

            <!-- ═══ iPart roboczy: kolumny rdzenia BOM + dane Klienta pozycji pod kursorem ═══ -->
            <TabItem Header="Integracja Danych">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="380" /></Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,12,0">
                        <TextBlock DockPanel.Dock="Top" Style="{DynamicResource Hint}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="Case, Footprint i Value — z bazy komponentów (po Part Number), a gdy komponentu nie ma w bazie — z danych Klienta po Comparatorze. Najedź na pozycję, żeby zobaczyć dane z BOM Klienta." />
                        <Border Style="{DynamicResource Card}" Padding="0">
                            <DataGrid x:Name="CoreGrid" ItemsSource="{Binding CoreLines}" SelectedItem="{Binding SelectedCoreLine}" RowStyle="{DynamicResource BomLineRowStyle}"
                                      LoadingRow="CoreGrid_LoadingRow" MouseLeave="CoreGrid_MouseLeave" AutomationProperties.Name="Integracja Danych">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Lp." Binding="{Binding LineLabel}" Width="60" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Desygnatory" Binding="{Binding Designators}" Width="1.5*" MinWidth="120" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Ilość" Binding="{Binding Quantity}" Width="55" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Case" Binding="{Binding Core.Case.Value}" Width="*" MinWidth="90" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Footprint" Binding="{Binding Core.Footprint.Value}" Width="*" MinWidth="90" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Value" Binding="{Binding Core.Value.Value}" Width="*" MinWidth="90" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="PartNumber" Binding="{Binding Core.PartNumber}" Width="1.5*" MinWidth="130" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="Part TS" Binding="{Binding PartTs}" Width="*" MinWidth="90" ElementStyle="{StaticResource CellText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </DockPanel>

                    <Border Grid.Column="1" Background="{DynamicResource Ui.Surface}" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="1,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16">
                                <TextBlock Style="{DynamicResource SectionTitle}" Text="{Binding PreviewLine.LineLabel, StringFormat=Dane z BOM Klienta — linia {0}, TargetNullValue=Najedź na pozycję albo ją zaznacz}" />
                                <ItemsControl ItemsSource="{Binding PreviewLine.CustomerData}" AutomationProperties.Name="Dane z BOM Klienta">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Header}" Style="{DynamicResource Hint}" />
                                                <TextBlock Text="{Binding Value, TargetNullValue=—}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Skąd wartości w iParcie" Style="{StaticResource PanelTitle}" />
                                <TextBlock TextWrapping="Wrap" Style="{DynamicResource Hint}">
                                    <Run Text="Case: " /><Run Text="{Binding PreviewLine.Core.Case.Source, Mode=OneWay}" /><LineBreak />
                                    <Run Text="Footprint: " /><Run Text="{Binding PreviewLine.Core.Footprint.Source, Mode=OneWay}" /><LineBreak />
                                    <Run Text="Value: " /><Run Text="{Binding PreviewLine.Core.Value.Source, Mode=OneWay}" /><LineBreak />
                                    <Run Text="Komponent w bazie (MPN): " /><Run Text="{Binding PreviewLine.Core.Mpn, Mode=OneWay, TargetNullValue=—}" />
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ═══ Krok 5: Zatwierdzenie i wersje (panel — do uzgodnienia) ═══ -->
        <Grid Grid.Row="2" Margin="24,12,0,0" Visibility="{Binding IsApprovalStage, Converter={StaticResource BoolToVisibility}}">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,24,0" MaxWidth="900" HorizontalAlignment="Left">
                        <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="P&amp;P" Style="{DynamicResource SectionTitle}" />
                                <TextBlock Text="{Binding PnpState}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <Button Content="Zatwierdź P&amp;P (Technolog SMT)" Command="{Binding ApprovePnpCommand}" HorizontalAlignment="Left" Style="{DynamicResource MaterialDesignOutlinedButton}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Warunki" Style="{DynamicResource SectionTitle}" />
                                <TextBlock Text="{Binding ApproveConditions}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Zatwierdź BOM — nowa wersja" Style="{DynamicResource SectionTitle}" />
                                <RadioButton Content="Wersja dla ZK (zmiany tylko dla wskazanego ZK)" IsChecked="{Binding ApproveForOrder}" GroupName="kind" Margin="0,0,0,6" />
                                <RadioButton Content="Wersja bazowa pakietu" GroupName="kind" Margin="0,0,0,12" />
                                <TextBox Text="{Binding OrderNumber, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Numer ZK (nnn/rrrr)" Width="220"
                                         HorizontalAlignment="Left" Margin="0,0,0,12" IsEnabled="{Binding ApproveForOrder}" Style="{DynamicResource MaterialDesignOutlinedTextBox}" />
                                <TextBox Text="{Binding ApproveComment, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Komentarz (trafi do historii)"
                                         Style="{DynamicResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" />
                                <TextBlock Text="Zatwierdzenia nie cofa się — zmiana to nowa wersja." Style="{DynamicResource Hint}" Margin="0,0,0,8" />
                                <Button Content="Zatwierdź BOM" Command="{Binding ApproveBomCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Zatwierdzone wersje" Style="{DynamicResource SectionTitle}" />
                        <ListBox ItemsSource="{Binding Versions}" DisplayMemberPath="DisplayName" AutomationProperties.Name="Wersje BOM" />
                    </StackPanel>
                </ScrollViewer>
        </Grid>

        <!-- Dół: komunikat ostatniej operacji i przejścia między krokami (dalej — zawsze po prawej) -->
        <Border Grid.Row="3" Background="{DynamicResource Ui.Surface}" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,1,0,0" Padding="24,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsComparatorStage, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="← Wróć do kroku 2" Command="{Binding BackToPnpCommand}" Style="{DynamicResource MaterialDesignOutlinedButton}" />
                    <Button Content="Dalej: Integracja Danych  →" Command="{Binding NextStageCommand}" Margin="0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsIntegrationStage, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="← Wróć do kroku 3" Command="{Binding BackToComparatorCommand}" Style="{DynamicResource MaterialDesignOutlinedButton}" />
                    <Button Content="Dalej: Zatwierdzenie i wersje  →" Command="{Binding NextStageCommand}" Margin="0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsApprovalStage, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="← Wróć do kroku 4" Command="{Binding BackToIntegrationCommand}" Style="{DynamicResource MaterialDesignOutlinedButton}" Margin="0" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Ui.Info.Text}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
