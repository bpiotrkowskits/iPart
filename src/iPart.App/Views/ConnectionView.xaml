<UserControl x:Class="iPart.App.Views.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock Text="iPart" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Text="{Binding AppVersion}" Margin="0,0,0,4" />
        <TextBlock Text="{Binding CurrentUser, StringFormat=Zalogowany użytkownik Windows: {0}}" Margin="0,0,0,20" />
        <Button Content="Sprawdź połączenie z bazą" Command="{Binding CheckConnectionCommand}" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding Status}" Margin="0,16,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <TextBox Text="{Binding ConnectionDetails, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Margin="0,12,0,0" />
    </StackPanel>
</UserControl>
