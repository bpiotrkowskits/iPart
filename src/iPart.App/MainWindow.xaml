<Window x:Class="iPart.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:iPart.App"
        mc:Ignorable="d"
        Title="iPart" Height="820" Width="1280" MinHeight="640" MinWidth="980">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Resources/DataColors.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <!-- 8.1 Linie BOM: niepotwierdzona linia; pełna informacja w podpowiedzi (8.4) -->
        <Style x:Key="BomLineRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Confirmed}" Value="False">
                    <Setter Property="Background" Value="{StaticResource Data.Line.Unconfirmed}" />
                    <Setter Property="Foreground" Value="{StaticResource Data.Text}" />
                    <Setter Property="ToolTip" Value="Linia niepotwierdzona" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 8.1 Komponenty: montaż THT, Press-Fit albo MECH -->
        <Style x:Key="ComponentRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNonSmtMounting}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Data.Line.NonSmtMounting}" />
                    <Setter Property="Foreground" Value="{StaticResource Data.Text}" />
                    <Setter Property="ToolTip" Value="{Binding Mounting}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="RowHeight" Value="28" />
        </Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,6" /><Setter Property="Margin" Value="0,0,8,0" /></Style>
        </ResourceDictionary>
    </Window.Resources>
    <TabControl Margin="16">
        <TabItem Header="Pakiety" DataContext="{Binding Packages}">
            <Grid Margin="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="340" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Content="Odśwież" Command="{Binding RefreshCommand}" DockPanel.Dock="Right" Margin="8,0,0,0" />
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" ToolTip="Szukaj po kodzie pakietu lub nazwie Klienta" />
                    </DockPanel>
                    <GroupBox DockPanel.Dock="Bottom" Header="Nowy pakiet" Margin="0,8,0,0" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Kod pakietu (np. PCBA1)" />
                            <TextBox Text="{Binding NewCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                            <TextBlock Text="Rewizja Klienta (np. C)" />
                            <TextBox Text="{Binding NewRevision, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                            <TextBlock Text="Klient" />
                            <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" Margin="0,2,0,4" />
                            <DockPanel Margin="0,0,0,6">
                                <Button Content="Dodaj Klienta" Command="{Binding AddCustomerCommand}" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="8,2" />
                                <TextBox Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nazwa nowego Klienta" />
                            </DockPanel>
                            <TextBlock Text="Opis (opcjonalnie)" />
                            <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                            <Button Content="Utwórz pakiet" Command="{Binding CreatePackageCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </GroupBox>
                    <ListBox ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}" DisplayMemberPath="DisplayName" />
                </DockPanel>
                <DockPanel Grid.Column="2">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Rewizja importu BOM: " VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding Revisions}" SelectedItem="{Binding SelectedRevision}" DisplayMemberPath="DisplayName" MinWidth="320" HorizontalAlignment="Left" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Lines}" RowStyle="{StaticResource BomLineRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Linia" Binding="{Binding LineNumber}" Width="50" />
                            <DataGridTextColumn Header="Designator" Binding="{Binding Designators}" Width="200" />
                            <DataGridTextColumn Header="Szt. desyg." Binding="{Binding DesignatorCount}" Width="70" />
                            <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="65" />
                            <DataGridTextColumn Header="Part TS" Binding="{Binding PartTs}" Width="140" />
                            <DataGridTextColumn Header="Footprint" Binding="{Binding Footprint}" Width="120" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="180" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="100" />
                            <DataGridTextColumn Header="Part Number" Binding="{Binding PartNumber}" Width="160" />
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="120" />
                            <DataGridCheckBoxColumn Header="Confirmed" Binding="{Binding Confirmed}" Width="75" />
                            <DataGridTextColumn Header="Kolumny dodatkowe" Binding="{Binding Extras}" Width="300" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </TabItem>
        <TabItem Header="Import BOM" DataContext="{Binding BomImport}">
            <Grid Margin="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Pakiet: " VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding PackageList.Packages}" SelectedItem="{Binding SelectedPackage}" DisplayMemberPath="DisplayName" MinWidth="300" Margin="0,0,8,0" />
                    <Button Content="Odśwież listę pakietów" Command="{Binding PackageList.RefreshCommand}" />
                </StackPanel>
                <DockPanel Grid.Row="1" Margin="0,0,0,8">
                    <Button Content="Wybierz plik BOM (.xlsx)" Command="{Binding ChooseFileCommand}" DockPanel.Dock="Left" />
                    <TextBox Text="{Binding FilePath, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" />
                </DockPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Arkusz: " VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Sheets}" SelectedItem="{Binding SelectedSheet}" MinWidth="160" Margin="0,0,16,0" />
                    <TextBlock Text="Wiersz nagłówków: " VerticalAlignment="Center" />
                    <TextBox Text="{Binding HeaderRow, UpdateSourceTrigger=LostFocus}" Width="50" VerticalContentAlignment="Center" Margin="0,0,16,0" />
                    <Button Content="Podpowiedz po nazwach nagłówków" Command="{Binding SuggestCommand}" />
                    <Button Content="Podgląd" Command="{Binding PreviewCommand}" />
                </StackPanel>
                <DataGrid Grid.Row="3" ItemsSource="{Binding Columns}" IsReadOnly="False" SelectionUnit="Cell">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kol." Binding="{Binding Letter}" IsReadOnly="True" Width="45" />
                        <DataGridTextColumn Header="Nagłówek Klienta" Binding="{Binding Header}" IsReadOnly="True" Width="200" />
                        <DataGridTemplateColumn Header="Pole w iPart" Width="280">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.FieldOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedValuePath="Field" DisplayMemberPath="Label"
                                              SelectedValue="{Binding Field, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Priorytet (1 = nadrzędna)" Binding="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                        <DataGridTextColumn Header="Przykładowe wartości" Binding="{Binding Sample}" IsReadOnly="True" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="4" Text="{Binding Summary}" Margin="0,8" FontWeight="SemiBold" />
                <TabControl Grid.Row="5">
                    <TabItem Header="Problemy">
                        <DataGrid ItemsSource="{Binding Issues}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ważność" Binding="{Binding SeverityLabel}" Width="100" />
                                <DataGridTextColumn Header="Linia" Binding="{Binding LineNumber}" Width="55" />
                                <DataGridTextColumn Header="Wiersz Excela" Binding="{Binding SourceRow}" Width="95" />
                                <DataGridTextColumn Header="Opis" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Podgląd linii">
                        <DataGrid ItemsSource="{Binding PreviewLines}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Linia" Binding="{Binding LineNumber}" Width="50" />
                                <DataGridTextColumn Header="Designator" Binding="{Binding Designators}" Width="200" />
                                <DataGridTextColumn Header="Szt. desyg." Binding="{Binding DesignatorCount}" Width="70" />
                                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="65" />
                                <DataGridTextColumn Header="Part TS" Binding="{Binding PartTs}" Width="140" />
                                <DataGridTextColumn Header="Footprint" Binding="{Binding Footprint}" Width="120" />
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="100" />
                                <DataGridTextColumn Header="Part Number" Binding="{Binding PartNumber}" Width="160" />
                                <DataGridTextColumn Header="Kolumny dodatkowe" Binding="{Binding Extras}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
                <DockPanel Grid.Row="6" Margin="0,8,0,0">
                    <Button Content="Zapisz jako nową rewizję importu" Command="{Binding SaveCommand}" DockPanel.Dock="Left" />
                    <TextBlock Text="Komentarz: " VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" Width="300" DockPanel.Dock="Left" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                </DockPanel>
            </Grid>
        </TabItem>
        <TabItem Header="Komponenty" DataContext="{Binding Components}">
            <DockPanel Margin="12">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="MPN zawiera: " VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <Button Content="Szukaj" Command="{Binding SearchCommand}" DockPanel.Dock="Right" Margin="8,0,0,0" IsDefault="False" />
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
                <DataGrid ItemsSource="{Binding Items}" RowStyle="{StaticResource ComponentRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="MPN" Binding="{Binding Mpn}" Width="240" />
                        <DataGridTextColumn Header="Montaż" Binding="{Binding Mounting}" Width="100" />
                        <DataGridTextColumn Header="Obudowa (Case)" Binding="{Binding CaseName}" Width="160" />
                        <DataGridTextColumn Header="Footprint" Binding="{Binding Footprint}" Width="160" />
                        <DataGridTextColumn Header="Uwagi" Binding="{Binding Notes}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
        <TabItem Header="Połączenie z bazą">
            <StackPanel Margin="24" VerticalAlignment="Center">
                <TextBlock Text="iPart" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Text="{Binding AppVersion}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding CurrentUser, StringFormat=Zalogowany użytkownik Windows: {0}}" Margin="0,0,0,20" />
                <Button Content="Sprawdź połączenie z bazą" Command="{Binding CheckConnectionCommand}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding Status}" Margin="0,16,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBox Text="{Binding ConnectionDetails, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </TabItem>
        <TabItem Header="Import dataPart (podgląd)" DataContext="{Binding Import}">
            <Grid Margin="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <Button Content="Wybierz plik .xlsx" Command="{Binding ChooseFileCommand}" DockPanel.Dock="Left" />
                    <TextBox Text="{Binding FilePath, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" />
                </DockPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Analizuj plik" Command="{Binding AnalyzeCommand}" />
                    <Button Content="Anuluj" Command="{Binding CancelCommand}" />
                    <Button Content="Eksportuj raport…" Command="{Binding ExportCommand}" />
                    <TextBlock Text="Podgląd — bez zapisu do SQL Server" VerticalAlignment="Center" Foreground="#365B75" />
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,0,0,8">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="10" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <TextBlock Grid.Row="3" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,4,0,12" />
                <TabControl Grid.Row="4">
                    <TabItem Header="Podgląd komponentów">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="4"><Button Content="Poprzednia" Command="{Binding PreviousRecordsCommand}" /><Button Content="Następna" Command="{Binding NextRecordsCommand}" /><TextBlock Text="{Binding RecordPageLabel}" VerticalAlignment="Center" /></StackPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding RecordPage}" SelectedItem="{Binding SelectedRecord}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Wiersz" Binding="{Binding SourceRow}" Width="65" />
                                    <DataGridTextColumn Header="MPN" Binding="{Binding Mpn}" Width="230" />
                                    <DataGridTextColumn Header="Stan" Binding="{Binding Status}" Width="160" />
                                    <DataGridTextColumn Header="Montaż" Binding="{Binding Mounting}" Width="85" />
                                    <DataGridTextColumn Header="Obudowa" Binding="{Binding Component.CaseName}" Width="120" />
                                    <DataGridTextColumn Header="Footprint" Binding="{Binding Component.Footprint}" Width="120" />
                                    <DataGridTextColumn Header="Value ze źródła" Binding="{Binding SourceValue}" Width="160" />
                                    <DataGridTextColumn Header="Value rezystora" Binding="{Binding GeneratedValue}" Width="220" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="2" Text="Proponowane wartości i pochodzenie pól zaznaczonego rekordu (pełna dokładność)" Margin="4,8" />
                            <DataGrid Grid.Row="3" ItemsSource="{Binding SelectedFields}"><DataGrid.Columns>
                                <DataGridTextColumn Header="Pole" Binding="{Binding Field}" Width="300" /><DataGridTextColumn Header="Propozycja" Binding="{Binding Value}" Width="220" /><DataGridTextColumn Header="Źródła" Binding="{Binding Sources}" Width="*" />
                            </DataGrid.Columns></DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Problemy">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="4"><TextBlock Text="Ważność: " VerticalAlignment="Center" /><ComboBox ItemsSource="{Binding Severities}" SelectedItem="{Binding Severity}" Width="150" Margin="0,0,12,0" /><Button Content="Poprzednia" Command="{Binding PreviousIssuesCommand}" /><Button Content="Następna" Command="{Binding NextIssuesCommand}" /><TextBlock Text="{Binding IssuePageLabel}" VerticalAlignment="Center" /></StackPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding IssuePage}"><DataGrid.Columns>
                                <DataGridTextColumn Header="Ważność" Binding="{Binding SeverityLabel}" Width="105" /><DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="180" /><DataGridTextColumn Header="Wiersz partsData" Binding="{Binding PartRow}" Width="100" /><DataGridTextColumn Header="Komórki" Binding="{Binding Locations}" Width="240" /><DataGridTextColumn Header="Problem" Binding="{Binding Message}" Width="650" />
                            </DataGrid.Columns></DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Źródło (wszystkie arkusze)">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="120" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="4"><CheckBox Content="Tylko niezamapowane" IsChecked="{Binding UnmappedOnly}" VerticalAlignment="Center" Margin="0,0,16,0" /><Button Content="Poprzednia" Command="{Binding PreviousSourcesCommand}" /><Button Content="Następna" Command="{Binding NextSourcesCommand}" /><TextBlock Text="{Binding SourcePageLabel}" VerticalAlignment="Center" /></StackPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding SourcePage}" SelectedItem="{Binding SelectedSourceCell}"><DataGrid.Columns>
                                <DataGridTextColumn Header="Arkusz" Binding="{Binding Sheet}" Width="130" /><DataGridTextColumn Header="Komórka" Binding="{Binding Address}" Width="75" /><DataGridTextColumn Header="Nagłówek" Binding="{Binding Header}" Width="155" /><DataGridTextColumn Header="Oryginalna wartość / formuła" Binding="{Binding OriginalValue}" Width="360" /><DataGridTextColumn Header="Zapisany wynik" Binding="{Binding Value}" Width="200" /><DataGridTextColumn Header="Format" Binding="{Binding NumberFormat}" Width="120" /><DataGridTextColumn Header="Mapowanie" Binding="{Binding Mapping}" Width="260" />
                            </DataGrid.Columns></DataGrid>
                            <TextBlock Grid.Row="2" Text="Pełna treść zaznaczonej komórki (w tym długie notatki i formuły)" Margin="4,8" />
                            <TextBox Grid.Row="3" Text="{Binding SourceDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="Mapowanie">
                        <StackPanel Margin="16" IsEnabled="{Binding CanChangeMapping}">
                            <TextBlock FontWeight="SemiBold" Text="Jawne decyzje dla starszych nazw PADS" Margin="0,0,0,14" />
                            <CheckBox Content="Zatwierdzam mapowanie ThP → TP" IsChecked="{Binding ConfirmThP}" Margin="0,0,0,12" />
                            <CheckBox Content="Zatwierdzam mapowanie NonS → NS" IsChecked="{Binding ConfirmNonS}" Margin="0,0,0,18" />
                            <TextBlock TextWrapping="Wrap" Text="Po zmianie decyzji analizuj plik ponownie. Bez zatwierdzenia komórki pozostają niezamapowane i widoczne w raporcie." Margin="0,0,0,20" />
                            <TextBlock TextWrapping="Wrap" Text="partsData: Part Number → MPN; Mounting → sposób montażu; Case → obudowa; Footprint → footprint; Notes → uwagi; Critical → Critical. Alias montażu: MECH → Mech. Producent i klient pozostają NULL; nawiasy w MPN są zachowywane." Margin="0,0,0,14" />
                            <TextBlock TextWrapping="Wrap" Text="resValue / capValue / ctceValue: parametry łączone według MPN z rozróżnianiem wielkości liter. Liczbowe komórki bez tekstowej jednostki oznaczają jednostkę bazową pola (Ω, W, pF, V, %, ppm/°C, mΩ, h). Tolerancje tekstowe wymagają % albo jednostki pojemności. Value Excela służy wyłącznie porównaniu." />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Arkusze i kolumny">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <DataGrid ItemsSource="{Binding Sheets}"><DataGrid.Columns><DataGridTextColumn Header="Arkusz" Binding="{Binding Name}" Width="200" /><DataGridTextColumn Header="Przeznaczenie" Binding="{Binding Purpose}" Width="300" /><DataGridTextColumn Header="Wiersz nagłówków" Binding="{Binding HeaderRow}" Width="130" /><DataGridTextColumn Header="Wiersze źródłowe" Binding="{Binding DataRows}" Width="130" /><DataGridTextColumn Header="Wiersze samych formuł (pominięte)" Binding="{Binding IgnoredFormulaRows}" Width="220" /></DataGrid.Columns></DataGrid>
                            <TextBlock Grid.Row="1" Text="Wykryte niezamapowane kolumny — zawartość dostępna w zakładce Źródło" Margin="4,8" />
                            <ListBox Grid.Row="2" ItemsSource="{Binding UnmappedColumns}" VirtualizingPanel.IsVirtualizing="True" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
