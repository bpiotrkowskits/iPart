<Window x:Class="iPart.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:iPart.App"
        mc:Ignorable="d"
        Title="iPart" Height="280" Width="620" MinHeight="260" MinWidth="460">
    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="iPart" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,20" />
            <Button Content="Sprawdź połączenie z bazą"
                    Command="{Binding CheckConnectionCommand}"
                    HorizontalAlignment="Left" Padding="16,10" />
            <TextBlock Text="{Binding Status}" Margin="0,16,0,0" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Grid>
</Window>
