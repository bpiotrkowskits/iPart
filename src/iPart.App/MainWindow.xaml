<Window x:Class="iPart.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:iPart.App.ViewModels"
        xmlns:views="clr-namespace:iPart.App.Views"
        Title="iPart" Height="860" Width="1360" MinHeight="640" MinWidth="1024"
        Background="{DynamicResource Ui.Background}"
        TextElement.Foreground="{DynamicResource Ui.Text}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Window.Resources>
        <!-- Motyw scalony w oknie (nie w App.xaml), żeby okno działało także w testach bez obiektu Application. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <!-- Nawigacja ViewModel-first: widok wynika z typu strony. -->
            <DataTemplate DataType="{x:Type vm:AccountSelectionViewModel}"><views:AccountSelectionView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PackagesViewModel}"><views:PackagesView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PackageBomViewModel}"><views:PackageBomView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PnpImportViewModel}"><views:PnpImportView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:BomImportViewModel}"><views:BomImportView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ComponentsViewModel}"><views:ComponentsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ImportExcelViewModel}"><views:DataPartImportView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConnectionViewModel}"><views:ConnectionView /></DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <!-- Nagłówek -->
        <Border DockPanel.Dock="Top" Height="56" Background="{DynamicResource Ui.Surface}" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,0,1" Padding="24,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource Ui.TextSecondary}">
                    <Run Text="{Binding AppVersion, Mode=OneWay}" /><Run Text="   " /><Run Text="Konto: " /><Run Text="{Binding AccountName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Ui.Text}" />
                </TextBlock>
                <TextBlock Text="iPart" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <!-- Menu (po wyborze konta) -->
        <Border DockPanel.Dock="Left" Width="230" Background="{DynamicResource Ui.Surface}" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,1,0"
                Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
            <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}" DisplayMemberPath="Title" Margin="8,12"
                     AutomationProperties.Name="Menu główne" />
        </Border>
        <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
    </DockPanel>
</Window>
